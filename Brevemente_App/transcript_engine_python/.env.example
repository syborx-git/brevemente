# ==========================================
# Transcription Engine Configuration (.env)
# ==========================================

# Application Settings
APP_NAME="Brevemente Transcription Engine"
APP_VERSION="1.0.0"
ENV="development"
HOST="0.0.0.0"
PORT=8000

# Security (Header: X-Internal-API-Key)
INTERNAL_API_KEY="dev-secret-api-key-change-in-prod"

# Faster-Whisper Model Settings
# Perfiles disponibles:
#   - "base": Ultraligero (140MB). Ideal para desarrollo rápido y pruebas en CPU.
#   - "small": Equilibrado (460MB). Mayor precisión general.
#   - "large-v3-turbo": MÁXIMA FIDELIDAD CLÍNICA (809MB). Entiende jerga médica/TBE, CIE-11, DSM-5TR, susurros y llanto.
WHISPER_MODEL_SIZE="base"

# Options for WHISPER_DEVICE: cpu, cuda
WHISPER_DEVICE="cpu"

# Options for WHISPER_COMPUTE_TYPE:
# For CPU: int8, float32
# For GPU (CUDA): float16, int8_float16, int8, float32
WHISPER_COMPUTE_TYPE="int8"

# Optional path to local cache folder for model weights (empty uses huggingface default cache)
WHISPER_DOWNLOAD_ROOT="./models_cache"

# ==========================================
# Long Audio Optimization (30 - 60 min sessions)
# ==========================================
# Dedicated CPU threads per transcription (prevents CPU thrashing when multiple audios arrive)
WHISPER_CPU_THREADS=4

# Background workers for reading/decoding audio files
WHISPER_NUM_WORKERS=1

# Beam search width (1=Greedy/Fastest, 2=Balanced 2x speedup, 5=Exhaustive/Slow)
WHISPER_BEAM_SIZE=2

# Enable BatchedInferencePipeline for 3x - 5x speedup on long audio files
WHISPER_USE_BATCHED=true

# Batch size for BatchedInferencePipeline (e.g. 8 for CPU, 16 for GPU)
WHISPER_BATCH_SIZE=8

# Anti-hallucination: avoids repeating errors across long 60-min sessions
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false

# Voice Activity Detection: discards silent pauses longer than 500ms
WHISPER_VAD_MIN_SILENCE_DURATION_MS=500

# LEVA - Contexto clínico para Whisper (sesga el vocabulario hacia jerga TBE/CIE-11/DSM-5TR).
# Opcional: si se omite se usa el prompt clínico por defecto definido en app/config.py.
# Para desactivarlo, déjalo vacío: WHISPER_INITIAL_PROMPT=""
# WHISPER_INITIAL_PROMPT="Sesión de psicoterapia en español entre terapeuta y paciente. Terapia Breve Estratégica (TBE)..."

# Concurrency & Workloads
MAX_CONCURRENT_TRANSCRIPTIONS=2

# Audio Temp Directory
TEMP_DIR="./tmp/transcriptions"

# Callback HTTP Client Settings
CALLBACK_TIMEOUT_SECONDS=30.0

# ==========================================
# Speaker Diarization Settings
# ==========================================
# Activa el motor acústico de separación de interlocutores
ENABLE_ACOUSTIC_DIARIZATION=true

# Opcional: HuggingFace Token para PyAnnote Audio (speaker-diarization-3.1 biométrico)
# Si está vacío, utiliza el detector acústico conversacional de turnos por pausas
HF_TOKEN=""

# Número esperado de interlocutores en consulta psicoterapéutica (Terapeuta + Paciente)
DIARIZATION_MIN_SPEAKERS=2
DIARIZATION_MAX_SPEAKERS=2

