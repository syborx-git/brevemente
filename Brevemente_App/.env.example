# ==============================================================================
# BreveMente Platform - Production Environment Variables for Hetzner
# Servidor: CPX41 / 16GB RAM | IP: 188.245.203.48
# ==============================================================================

# 1. Base de Datos PostgreSQL
POSTGRES_DB=brevemente_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=genera_un_password_seguro_aqui

# 2. Seguridad y JWT
JWT_SECRET=genera_un_jwt_secret_largo_de_al_menos_64_caracteres_hex_o_base64_aqui
COOKIE_SECURE=false

# 3. CORS & Dominios Permitidos (IP de Hetzner o tu dominio)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://188.245.203.48,https://188.245.203.48

# 4. Comunicación Interna Backend <-> Python Transcriptor
INTERNAL_API_KEY=genera_una_clave_api_interna_secreta_aqui

# 5. Modelo de Inteligencia Artificial (Ollama)
# En CPX41 (16GB RAM) se recomienda 'llama3.1:8b'
LEVA_OLLAMA_MODEL=llama3.1:8b

# 6. Modelo de Transcripción de Voz (faster-whisper)
# Opciones: tiny, base, small, medium
WHISPER_MODEL_SIZE=small
